{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orchestra package manifest",
  "type": "object",
  "required": ["manifest_version", "package_id", "generated_at", "excluded_paths", "files"],
  "properties": {
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "size", "sha256"],
        "properties": {
          "size": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
