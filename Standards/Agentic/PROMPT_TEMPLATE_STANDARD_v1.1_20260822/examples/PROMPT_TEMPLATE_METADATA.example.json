  },
  "execution_contract": {
    "interaction_mode": "clarify-on-blocker",
    "mutation_mode": "scoped-edit",
    "continuation_behavior": "handoff/state artifact required for multisession continuation"
  },
  "tool_contract": {
    "requires": ["file read/write", "test execution"],
    "optional": ["static analysis", "package builder"],
    "runtime_notes": "Provider-specific tool names belong in the runtime binding."
  },
  "output_contract": {
    "artifacts": ["implemented files", "updated tests", "updated build state"],
    "reporting": "Report validation evidence and unresolved blockers."
  },
  "validation_contract": {
    "required_checks": ["local tests", "integration gate"],
    "success_evidence": ["test results"],
    "successor_validator": null
  },
  "completion_contract": [
    "requested implementation exists",
    "required tests pass",
    "repository build state is updated"
  ],
  "failure_contract": {
    "semantic_blocker": "surface and stop the affected path",
    "validation_failure": "repair before claiming completion"
  },
  "handoff_contract": {
