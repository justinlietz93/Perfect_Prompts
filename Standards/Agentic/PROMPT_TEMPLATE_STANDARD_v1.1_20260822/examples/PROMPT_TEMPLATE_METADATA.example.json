    "read-only review",
    "architecture is still materially unresolved"
  ],
  "governing_standards": ["prompt-template-standard"],
  "required_authority_inputs": ["user request", "project canon when present"],
  "compatible_methodologies": ["emergence-based-design"],
  "compatible_rulesets": [],
  "persona_policy": "OPTIONAL",
  "input_contract": {
    "required_semantic_inputs": ["approved desired state", "governing architecture or plan"],
    "required_operational_inputs": ["repository access"],
    "optional_context": ["prior implementation notes"],
    "defaultable_inputs": ["incidental local naming where unconstrained"],
    "derived_inputs": ["current repository state"],
    "missing_input_policy": "Inspect authoritative state first; stop or surface a blocker when a missing semantic input can change architecture or correctness."
  },
  "authority_contract": {
